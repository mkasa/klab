#! /bin/sh

# waf configure wrapper

# Fancy colors used to beautify the output a bit.
#
if [ "$NOCOLOR" ] ; then
    NORMAL=""
    BOLD=""
    RED=""
    YELLOW=""
    GREEN=""
else
    NORMAL='\033[0m'
    BOLD='\033[01;1m'
    RED='\033[01;91m'
    YELLOW='\033[00;33m'
    GREEN='\033[01;92m'
fi

EXIT_SUCCESS=0
EXIT_FAILURE=1
EXIT_ERROR=2
EXIT_BUG=10

CUR_DIR=$PWD

#possible relative path
WORKINGDIR=`dirname "$0"`
cd "$WORKINGDIR" || exit $EXIT_FAILURE
#abs path
WORKINGDIR=`pwd`
cd "$CUR_DIR" || exit $EXIT_FAILURE

# Out-of-tree builds are not supported: the generated Makefile is written into
# the current directory and waf is run from there as well, so waf would not
# find the wscript. Detect this early instead of silently generating a Makefile
# in a directory that has no wscript.
if [ "$WORKINGDIR" != "$CUR_DIR" ] ; then
    printf '%bERROR: out-of-tree builds are not supported.%b\n' "$RED" "$NORMAL"
    echo "Please run configure from the top of the source tree:"
    echo "    cd \"$WORKINGDIR\" && ./configure"
    exit $EXIT_FAILURE
fi

# Checks for WAF. Honours $WAF if set. Stores path to 'waf' in $WAF.
# Requires that $PYTHON is set.
#
checkWAF()
{
	printf "Checking for WAF\t\t\t:  "
	#installed miniwaf in sourcedir
	if [ -z "$WAF" ] ; then
	    if [ -f "${WORKINGDIR}/waf" ] ; then
		WAF="${WORKINGDIR}/waf"
		if [ ! -x "$WAF" ] ; then
		    chmod +x "$WAF"
		fi
	    fi
	fi
	if [ -z "$WAF" ] ; then
	    if [ -f "${WORKINGDIR}/waf-light" ] ; then
		"${WORKINGDIR}/waf-light" --make-waf
	        WAF="${WORKINGDIR}/waf"
	    fi
	fi
	#global installed waf with waf->waf.py link
	if [ -z "$WAF" ] ; then
	    WAF=`command -v waf 2>/dev/null`
	fi
	# neither waf nor miniwaf could be found
	if [ ! -x "$WAF" ] ; then
	    printf '%bnot found%b\n' "$RED" "$NORMAL"
	    echo "Go to https://waf.io/"
	    echo "and download a waf version"
	    exit $EXIT_FAILURE
	else
	  printf '%b%s%b\n' "$GREEN" "$WAF" "$NORMAL"
	fi
}

# Generates a Makefile. Requires that $WAF is set.
#
generateMakefile()
{
	cat > Makefile << EOF
#!/usr/bin/make -f
# Waf Makefile wrapper

all:
	@$WAF build

all-debug:
	@$WAF -v build

all-progress:
	@$WAF -p build

install:
	$WAF install

uninstall:
	$WAF uninstall

clean:
	@$WAF clean

distclean:
	@$WAF distclean
	@-rm -rf build
	@-rm -f Makefile

check:
	@$WAF check

dist:
	@$WAF dist

.PHONY: all all-debug all-progress clean dist distclean check uninstall install

EOF
}

checkWAF
generateMakefile

"${WAF}" configure "$@"
exit $?
