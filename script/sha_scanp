#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.8"
# dependencies = [
#     "click",
# ]
# ///

import click
import os
import sys
import re
import hashlib
import sqlite3
import concurrent.futures
from collections import deque


exclude_files_regex = (r'^\._',
                       r'^\.dropbox\.device$',
                       r'^\.fseventsd$',
                       r'^fseventsd-uuid$',
                       r'^WPSettings\.dat$',
                       r'^desktop\.ini$',
                       r'^\.git$',
                       r'^\.waf3-',
                       )

# Compiled counterpart of exclude_files_regex. It is (re)built by
# compile_exclude_regexes() before any scan starts so that a malformed
# pattern is reported as a clean argument error instead of blowing up
# in the middle of a directory walk.
compiled_exclude_regexes = []


def compile_exclude_regexes(patterns):
    """ Compile the exclusion patterns, reporting a clean error for a bad pattern """
    compiled = []
    for pattern in patterns:
        try:
            compiled.append(re.compile(pattern))
        except re.error as e:
            raise click.BadParameter("invalid regular expression {!r}: {}".format(pattern, e), param_hint='--exclude')
    return compiled


def is_name_excluded(name):
    """ Check if the file name is excluded from the scan """
    global compiled_exclude_regexes
    for regex in compiled_exclude_regexes:
        if regex.match(name):
            return True
    return False


def get_file_digest(file_name, eskip):
    digest = hashlib.sha256()
    try:
        with open(file_name, 'rb') as f:
            DIGEST_BLOCK_SIZE = 1024 * 1024
            for chunk in iter(lambda: f.read(DIGEST_BLOCK_SIZE), b""):
                digest.update(chunk)
    except IOError:
        print("Error: Unable to open file '{}'".format(file_name), file=sys.stderr)
        if eskip:
            return None
        raise
    return digest.hexdigest()


def hash_files_parallel(path_iter, num_threads, eskip):
    """ Hash files from path_iter (yielding (full_path, rel_path)) with a thread pool.
        Yields (full_path, rel_path, hex_digest) in the same order as path_iter.
        hex_digest is None when the file could not be read and --eskip was given. """
    with concurrent.futures.ThreadPoolExecutor(max_workers=num_threads) as executor:
        def collect(entry):
            full_path, rel_path, future = entry
            try:
                hex_digest = future.result()
            except IOError as e:
                print("Exiting due to the error. {}".format(e), file=sys.stderr)
                sys.exit(1)
            return full_path, rel_path, hex_digest
        max_in_flight = num_threads * 4
        in_flight = deque()
        for full_path, rel_path in path_iter:
            in_flight.append((full_path, rel_path, executor.submit(get_file_digest, full_path, eskip)))
            if max_in_flight <= len(in_flight):
                yield collect(in_flight.popleft())
        while in_flight:
            yield collect(in_flight.popleft())


def normalize_base_dir(dir_path):
    """ Canonicalize the directory given on the command line.

        os.path.realpath() makes the path absolute, drops a trailing slash,
        collapses '.'/'..' components and resolves symbolic links, so that
        'dir', 'dir/', './dir', '/abs/path/to/dir' and a symlink pointing at
        it all yield exactly the same base. Because the whole scan is driven
        by this canonical base, the same file always gets the same database
        key no matter how the directory was spelled on the command line. """
    return os.path.realpath(dir_path)


def database_key(full_path, dir_path):
    """ The primary key of a row in the database.

        It is the path of the file relative to the scanned directory
        (the directory given on the command line), so 'a.b.c' stays 'a.b.c'
        and nested files keep their sub-directory prefix. dir_path is
        expected to be already canonicalized by normalize_base_dir(), in
        which case the result never starts with './' and never contains a
        redundant '..' component.

        A file can still end up outside the base directory when the scan
        follows a symbolic link that points upwards (--followsymlink).
        Such a file is kept, with a '..'-prefixed key, rather than being
        silently dropped: --add exists to record hashes, and losing a hash
        is worse than an ugly key. A warning is printed so that the user
        knows the key is not a plain relative path. """
    rel_path = os.path.relpath(full_path, dir_path)
    if rel_path == os.pardir or rel_path.startswith(os.pardir + os.sep):
        print("Warning: '{}' is outside the scanned directory '{}'; "
              "storing it as '{}'".format(full_path, dir_path, rel_path), file=sys.stderr)
    return rel_path


def generate_full_and_relative_path(dir_path, root, fname):
    full_path = os.path.join(root, fname)
    return full_path, database_key(full_path, dir_path)


def walk_scan_files(dir_path, followsymlink, debug, stats):
    """ Walk dir_path and yield (full_path, rel_path) for files that are not excluded.
        Updates counters in stats as a side effect. """
    for root, directories, files in os.walk(dir_path, followlinks=followsymlink):
        if debug:
            print("Scanning '{}'".format(root), file=sys.stderr)
        for ix, dirname in reversed(list(enumerate(directories))):
            if is_name_excluded(dirname):
                del directories[ix]
                stats['num_excluded_dirs'] += 1
            else:
                stats['num_scanned_dirs'] += 1
        for fname in files:
            if is_name_excluded(fname):
                stats['num_excluded_files'] += 1
                continue
            stats['num_scanned_files'] += 1
            yield generate_full_and_relative_path(dir_path, root, fname)


def new_scan_stats():
    return {'num_scanned_files': 0, 'num_excluded_files': 0, 'num_excluded_dirs': 0, 'num_scanned_dirs': 1}


def add_files(db_file, dir_path, followsymlink, eskip, show_summary, num_threads, debug):
    """ Add files to the database """
    if not os.path.exists(db_file):
        print("Creating a new database '{}'".format(db_file), file=sys.stderr)
        connection = sqlite3.connect(db_file)
        cursor = connection.cursor()
        cursor.execute('''CREATE TABLE files (name text primary key, hash text)''')
        cursor.execute('''CREATE INDEX files_hash_index on files(hash)''')
    else:
        print("Using existing database '{}'".format(db_file), file=sys.stderr)
        connection = sqlite3.connect(db_file)
        cursor = connection.cursor()
    uncommited_file_count = 0
    num_files = 0
    num_skipped_files = 0
    path_iter = walk_scan_files(dir_path, followsymlink, debug, new_scan_stats())
    for full_path, rel_path, hex_digest in hash_files_parallel(path_iter, num_threads, eskip):
        if hex_digest is None:
            print("Skipped '{}' (could not be read)".format(rel_path), file=sys.stderr)
            num_skipped_files += 1
            continue
        print("Adding '{}': {}".format(rel_path, hex_digest), file=sys.stderr)
        num_files += 1
        # rel_path is already the database key (see database_key()).
        cursor.execute('''INSERT OR REPLACE INTO files VALUES (?, ?)''', (rel_path, hex_digest))
        uncommited_file_count += 1
        if 80 <= uncommited_file_count:
            connection.commit()
            uncommited_file_count = 0
    connection.commit()
    connection.close()
    if show_summary:
        print("Added {} files".format(num_files), file=sys.stderr)
        print("Skipped {} files".format(num_skipped_files), file=sys.stderr)


def search_files(do_remove, db_file, dir_path, eskip, followsymlink, show_only_new, show_summary, count_only, num_threads, debug):
    """ Search for files in the database """
    connection = sqlite3.connect(db_file)
    cursor = connection.cursor()
    stats = new_scan_stats()
    num_duplicated_files = 0
    num_new_files = 0
    num_skipped_files = 0
    num_removed_files = 0
    path_iter = walk_scan_files(dir_path, followsymlink, debug, stats)
    for full_path, rel_path, hex_digest in hash_files_parallel(path_iter, num_threads, eskip):
        if hex_digest is None:
            # The file could not be read at all, so we know nothing about it.
            # It is neither a known file nor a new file.
            num_skipped_files += 1
            if not count_only:
                print("Skipped '{}' (could not be read)".format(rel_path))
            continue
        if debug:
            print("Scanning '{}': {}".format(rel_path, hex_digest), file=sys.stderr)
        result = cursor.execute('''SELECT COUNT(*), MIN(name) FROM files WHERE hash = ?''', (hex_digest,))
        one_line = result.fetchone()
        num_entries_in_db, name_in_db = one_line[0], one_line[1]
        if debug:
            print("  Result = {}".format(num_entries_in_db), file=sys.stderr)
        if num_entries_in_db == 0:
            num_new_files += 1
            if not count_only:
                print("Not found '{}'".format(rel_path))
        else:
            num_duplicated_files += 1
            if not show_only_new and not count_only:
                print("Found '{}' ({}) same as '{}'".format(rel_path, num_entries_in_db, name_in_db))
            if do_remove:
                try:
                    os.remove(full_path)
                    num_removed_files += 1
                except OSError as e:
                    print("Error: Unable to remove file '{}'".format(full_path), file=sys.stderr)
                    if eskip:
                        continue
                    print("Exiting due to the error. {}".format(e), file=sys.stderr)
                    sys.exit(1)
    connection.close()
    if count_only:
        print("Known files: {}".format(num_duplicated_files))
        print("Unknown files: {}".format(num_new_files))
        print("Skipped files: {}".format(num_skipped_files))
        if do_remove:
            print("Removed files: {}".format(num_removed_files))
    if show_summary:
        print("Scanned {} files in {} directories".format(stats['num_scanned_files'], stats['num_scanned_dirs']), file=sys.stderr)
        print("Excluded {} files, {} dirs".format(stats['num_excluded_files'], stats['num_excluded_dirs']), file=sys.stderr)
        print("Skipped {} files".format(num_skipped_files), file=sys.stderr)
        print("Found {} duplicated files".format(num_duplicated_files), file=sys.stderr)
        if do_remove:
            print("Removed {} files".format(num_removed_files), file=sys.stderr)


@click.command()
@click.option('--add', is_flag=True, help='Add the file to the database')
@click.option('--search', is_flag=True, help='Search for the file in the database')
@click.option('--remove', is_flag=True, help='Remove the file when it is duplicated (found in the database)')
@click.option('--eskip', is_flag=True, help='Skip the error when the file cannot be opend in the database')
@click.option('--summary', is_flag=True, help='Show the summary of the scan')
@click.option('--new', is_flag=True, help='Show only the new files')
@click.option('--count', is_flag=True, help='Show only the number of known/unknown files (with --search or --remove)')
@click.option('--exclude', multiple=True, help='Exclude the file from the scan')
@click.option('--followsymlink', is_flag=True, help='Follow the symlink')
@click.option('--threads', '-j', type=int, default=None, help='Number of threads for hashing (default: number of CPUs)')
@click.option('--debug', is_flag=True, help='Show the debug information')
@click.argument('db_file_path')
@click.argument('dir_path')
def main(add, search, remove, eskip, summary, new, count, exclude, threads, debug, db_file_path, followsymlink, dir_path):
    """ Scan the directory and add the files to the database """
    global exclude_files_regex
    global compiled_exclude_regexes
    exclude_files_regex = exclude_files_regex + tuple(exclude)
    compiled_exclude_regexes = compile_exclude_regexes(exclude_files_regex)
    if debug:
        print('exclude_files_regex: {}'.format(exclude_files_regex))

    # Check if the input arguments are sane
    if not (add or search or remove):
        print('Please specify the action from --add, --search, --remove')
        sys.exit(1)
    if (add and search) or (add and remove) or (search and remove):
        print('Please specify only one action from --add, --search, --remove')
        sys.exit(1)
    if count and add:
        print('--count is meaningful only with --search or --remove.')
        sys.exit(1)
    if not add and not os.path.exists(db_file_path):
        print('Database file does not exist: %s' % db_file_path)
        sys.exit(1)
    if not os.path.exists(dir_path):
        print('Directory does not exist: %s' % dir_path)
        sys.exit(1)
    if not os.path.isdir(dir_path):
        print('Not a directory: %s' % dir_path)
        sys.exit(1)
    if not os.access(dir_path, os.R_OK):
        print('Directory is not readable: %s' % dir_path)
        sys.exit(1)
    # Canonicalize the base directory before the scan so that every database
    # key is relative to one single spelling of the scanned directory.
    dir_path = normalize_base_dir(dir_path)
    if debug:
        print('base directory: {}'.format(dir_path), file=sys.stderr)
    if threads is None:
        threads = os.cpu_count() or 1
    if threads < 1:
        print('The number of threads must be positive: %d' % threads)
        sys.exit(1)

    if add:
        add_files(db_file_path, dir_path, followsymlink, eskip, summary, threads, debug)
        sys.exit(0)
    if search:
        search_files(False, db_file_path, dir_path, eskip, followsymlink, new, summary, count, threads, debug)
        sys.exit(0)
    if remove:
        search_files(True, db_file_path, dir_path, eskip, followsymlink, new, summary, count, threads, debug)
        sys.exit(0)


if __name__ == '__main__':
    main()


"""
=pod

=head1 NAME

sha_scanp - Calculate SHA-256 hashes of files, and find duplicated files.

=head1 QUICKSTART

sha_scanp --add <DB name> <directory to scan>      (This is for the first scan phase)
sha_scanp --search <DB name> <directory to scan>   (This is to check files)
sha_scanp --remove <DB name> <directory to scan>   (This is to remove redundant files)

=head1 SYNOPSYS

Scan (files in) a directory:

B<sha_scanp> --add E<lt>DB fileE<gt> E<lt>input directoryE<gt>

Check (files in) a directory:

B<sha_scanp> --search E<lt>DB fileE<gt> E<lt>input directoryE<gt>

Check files in a directory but shows only new files:

B<sha_scanp> --new --search E<lt>DB fileE<gt> E<lt>input directoryE<gt>

Show only the number of known/unknown files:

B<sha_scanp> --count --search E<lt>DB fileE<gt> E<lt>input directoryE<gt>

Removed files in a directory when their hashes are in DB file:

B<sha_scanp> --remove E<lt>DB fileE<gt> E<lt>input directoryE<gt>

=head1 DESCRIPTION

First, you scan through a directory to create database of SHA-256 hashes of files in a directory.

B<sha_scanp> --add E<lt>DB fileE<gt> E<lt>input directoryE<gt>

The database is in SQLite3 format so you can view it using any SQLite3 clients.
If the database file already exists, it simply adds new hashes into the database.

Each row is keyed by the path of the file B<relative to the directory given on the command
line>. Scanning F</home/me/photos> that contains F<2024/IMG_0001.jpg> stores the key
F<2024/IMG_0001.jpg>, not the absolute path and not the bare base name. The key never
starts with F<./> and, for files genuinely under the scanned directory, never contains a
F<..> component.

The directory argument is canonicalized (made absolute, with a trailing slash, F<.>, F<..>
and symbolic links resolved) before the scan, so C<dir>, C<dir/>, C<./dir>, C<../foo/dir>,
the absolute path of the directory and a symbolic link pointing at it all produce exactly
the same keys. Consequently, re-scanning the same tree updates the existing rows in place
instead of creating near-duplicate rows.

=head2 LIMITATION: keys collide across different directories

Because the key is relative to the scanned directory, B<hashes from different directories
cannot safely be accumulated in a single database file>. If F</photos/a> and F</photos/b>
both contain F<IMG_0001.jpg>, scanning both into one database yields a single row keyed
F<IMG_0001.jpg>: the second scan silently overwrites the hash recorded by the first
(the insert is an C<INSERT OR REPLACE>). The hash of the earlier file is then simply gone
from the database, and C<--search> will report that file as unknown.

This is a deliberate trade-off in favour of short, human-readable, relocation-independent
keys. If you need to keep several directories on record, B<use one database file per
scanned directory>. Note that C<--search>, C<--remove> and the duplicate detection match on
the B<hash> only and never on the key, so within one scanned tree the collision affects
only which name is reported as the matching file, not whether a duplicate is detected.

=head2 Databases created by older versions

An earlier version of B<sha_scanp> keyed rows by the B<absolute> path of the file, and the
version before that stored a corrupted key (every C<.> was stripped from the path). Keys
written by those versions do not match the keys written by this version. Such databases are
not migrated automatically and there is no upgrade path: B<rebuild them from scratch> with
C<--add>. The stored hashes themselves stay valid, so C<--search> and C<--remove> keep
working against an old database; only the reported name of the matching file and any
in-place update of an existing row are affected.

Next, you want to see whether files in a specified directory match to the already-scanned files
in the database.

B<sha_scanp> --search E<lt>DB fileE<gt> E<lt>checking directoryE<gt>

For each file, it outputs whether a file of the same contents exists.
If such a file exists, it also outputs the path of one such file in the database.
If a file could not be read (only possible with B<--eskip>), it is reported as
skipped; a skipped file is counted neither as a known file nor as a new file.

If you wish to directly remove redacted files, please use

B<sha_scanp> --remove E<lt>DB fileE<gt> E<lt>checking directoryE<gt>

This will scan through all files under the given directory, and remove files if their hashes
are in the database file.

=head1 OPTIONS

=over 8

=item B<--add>
Hash every file under the given directory and store the hashes in the database.

=item B<--search>
Hash every file under the given directory and look each hash up in the database.

=item B<--remove>
Same as B<--search>, but files whose hash is already in the database are deleted.

=item B<--count>
This option is valid only if B<--search> or B<--remove> is given.
When you want to see if a specified directory contains any new files
(i.e., any files whose hash do not match with the files registered in the databases),
you just do not want to see a long list of results.
You just need whether all files in the directory are known or not.
When this option is given, sha_scanp outputs only the number of known/unknown/skipped files.

=item B<--eskip>
When a file could not be opened, B<sha_scanp> immediately quits, but it continues
when this option is given. It can be used with B<--add>, B<--search> and B<--remove>.
Files skipped this way are reported as skipped and counted separately.

=item B<--exclude>
Exclude files whose file name matches to a specified regex pattern.
The pattern is matched against the B<base name> only (not the whole path), and it is
also matched against directory names: a matching directory is pruned, so the whole
subtree below it is excluded from the scan.
The option can be given more than once. An invalid pattern is reported as an
argument error before the scan starts.

=item B<--followsymlink>
Follow symbolic links when scanning directories.

=item B<--new>
Show only new files. This option can be used only with B<--search> or B<--remove>.

=item B<--summary>
Show the summary of the scan result.

=item B<--threads>, B<-j>
The number of threads used for hashing files.
It defaults to the number of CPUs.
Hashing is done in parallel, while the database is accessed only from the main thread.

=item B<--debug>
Show debug information while scanning.

=back

=cut
"""
