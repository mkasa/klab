#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.8"
# dependencies = []
# ///
"""
csv2html: a standalone utility to convert CSV into HTML

usage: cat example.csv | csv2html [options...] [column names and attributes]

options:
    -v, --version     show the version and exit
    -n, --noheader    no header (i.e, the first line of CSV is not a header)
    -t, --notabletag  do not output the surrounding <table> tag

This utility converts an input file of CSV format into an HTML.
Here is an example.

(echo 'a,b,Salary,Performance'; echo 'John,Doe,12345,32.123456') | csv2html "First name/l" "Last name/l" /,r "/%.2"
<table>
<tr><th style="border-bottom: 1px solid black">First name</th><th style="border-bottom: 1px solid black">Last name</th><th style="border-bottom: 1px solid black">Salary</th><th style="border-bottom: 1px solid black">Performance</th></tr>
<tr><td style="text-align: left">John</td><td style="text-align: left">Doe</td><td style="text-align: right">12,345</td><td>32.12%</td></tr>
</table>

A column attribute contains both the column name and its attribute, which are separated by '/'.
If you do not need one of them, you can just omit it.
The left side of '/' is the column name, while the right side is the attribute.
If the column name is empty or a single period ('.'), the name in the header line of the
input CSV is used as it is.
If the attribute string contains '%', '%' is added to the column.
If the attribute string contains ',', then figures are separated by ',' at every 3 digits.
You can also specify 'printf-like' formatting string for floating numbers.
'.3' means three digits after the decimal point, while '05' means padding zeroes to 5 digits.
If you do want to specify an attribute for the header line, you can give it after '|' (still you need '/' before '|' in this case).
Header cells always carry a 'border-bottom: 1px solid black' style in addition to whatever
you specify.
Cell contents are HTML-escaped, and a cell that cannot be formatted as a number is emitted
as it is.

"""

import sys
import csv
import html
import argparse


version_string = "1.01"


def default_attributes():
    """ a fresh attribute dictionary; never share one between columns """
    return {'align': None, 'sepc': False, 'ratio': False, 'fmtr': "", 'header': False}


def add_thousands_separators(s):
    """ Insert ',' every three digits in the integer part of s.
        A leading sign is kept out of the digit grouping, and a string that is
        not a plain number is returned untouched. """
    sign = ''
    body = s
    if body[:1] in ('-', '+'):
        sign, body = body[0], body[1:]
    dot = body.find(".")
    if dot == -1:
        int_part, rest = body, ''
    else:
        int_part, rest = body[:dot], body[dot:]
    if not int_part.isdigit():
        return s
    groups = []
    i = len(int_part)
    while i > 3:
        groups.append(int_part[i - 3:i])
        i -= 3
    groups.append(int_part[:i])
    groups.reverse()
    return sign + ",".join(groups) + rest


class HTMLWriter:
    def __init__(self):
        self.row_open = False

    def styles_to_style_str(self, styles):
        if len(styles) <= 0:
            return ""
        else:
            return " style=\"" + html.escape("; ".join(styles), quote=True) + "\""

    def to_html_tag(self, tag_name, s, attrs):
        styles = []
        if attrs['align'] is not None:
            styles.append('text-align: ' + attrs['align'])
        if attrs['header']:
            styles.append('border-bottom: 1px solid black')
        retval = "<" + tag_name + self.styles_to_style_str(styles) + ">"
        if attrs['fmtr']:
            format_str = attrs['fmtr']
            if format_str.find(".") == -1:
                format_str += ".0"
            try:
                s = ("%" + format_str + "f") % float(s)
            except (ValueError, TypeError):
                # Not a number (or a broken format string). Emit the cell as it is
                # rather than aborting in the middle of the table.
                pass
        if attrs['sepc']:
            content = add_thousands_separators(s)
        else:
            content = s
        retval += html.escape(content)
        if attrs['ratio']:
            retval += '%'
        retval += "</" + tag_name + ">"
        return retval

    def start_row(self):
        sys.stdout.write("<tr>")
        self.row_open = True

    def end_row(self):
        sys.stdout.write("</tr>\n")
        self.row_open = False

    def writeheadrow(self, cols, attrs, col_names):
        self.start_row()
        for idx, i in enumerate(cols):
            a = attrs[idx] if idx < len(attrs) else default_attributes()
            name = col_names[idx] if idx < len(col_names) else None
            s = str(i) if name is None else name
            a['header'] = True
            sys.stdout.write(self.to_html_tag("th", s, a))
        self.end_row()

    def writerow(self, cols, attrs):
        self.start_row()
        for idx, i in enumerate(cols):
            a = attrs[idx] if idx < len(attrs) else default_attributes()
            a['header'] = False
            sys.stdout.write(self.to_html_tag("td", str(i), a))
        self.end_row()


def w(a):
    sys.stdout.write(a)


def warn_if_ragged(line_no, num_cells, num_cols):
    if num_cells != num_cols:
        print("WARNING: line %d has %d cell(s) while %d column(s) are expected" % (line_no, num_cells, num_cols),
              file=sys.stderr)


def parse_attributes(cfs, col_num):
    """ parses attribute strings, and returns a triplet of the column names, the header attributes and the data attributes """
    cnames = []
    hattr = []
    dattr = []

    def parse_attr_str(s):
        d = default_attributes()
        if len(s) < 1:
            return d
        i = 0
        while i < len(s):
            c = s[i]
            if "0123456789.-".find(c) != -1:
                while i < len(s) and "0123456789.-".find(s[i]) != -1:
                    d['fmtr'] += s[i]
                    i += 1
                i -= 1
            elif c == ',':
                d['sepc'] = True
            elif c == 'l':
                d['align'] = "left"
            elif c == 'r':
                d['align'] = "right"
            elif c == 'c':
                d['align'] = "center"
            elif c == '%':
                d['ratio'] = True
            i += 1
        return d
    for v in cfs:
        ri = v.rfind("/")
        if ri == -1:
            col_name = v
            attr_str = None
        else:
            col_name = v[0:ri]
            attr_str = v[ri + 1:]
        if col_name == "" or col_name == ".":
            cnames.append(None)
        else:
            cnames.append(col_name)
        if attr_str is None:
            hattr.append(default_attributes())
            dattr.append(default_attributes())
        else:
            pi = attr_str.rfind("|")
            if pi == -1:
                hattr.append(default_attributes())
                dattr.append(parse_attr_str(attr_str))
            else:
                dattr.append(parse_attr_str(attr_str[0:pi]))
                hattr.append(parse_attr_str(attr_str[pi + 1:]))
    while len(cnames) < col_num:
        cnames.append(None)
        hattr.append(default_attributes())
        dattr.append(default_attributes())
    return cnames, hattr, dattr


def main():
    # Parse arguments
    parser = argparse.ArgumentParser(description='Convert CSV (comma separated values) into an HTML table',
                                     epilog=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('colfmt', nargs='*', action='store', help="Column formats")
    parser.add_argument('-n', '--noheader', action='store_true', help="Suppress a header")
    parser.add_argument('-t', '--notabletag', action='store_true', help="Suppress a table tag")
    parser.add_argument('-v', '--version', action='store_true', help="Show version string")
    args = parser.parse_args()

    if args.version:
        print("csv2html version %s" % version_string)
        sys.exit(0)
    (column_names, header_attrs, data_attrs) = (None, None, None)
    if not args.notabletag:
        w("<table>\n")
    writer = HTMLWriter()
    line_count = 0
    exit_code = 0
    reader = None
    try:
        reader = csv.reader(sys.stdin)
        is_first_line = True
        for line in reader:
            line_count += 1
            if is_first_line:
                is_first_line = False
                try:
                    (column_names, header_attrs, data_attrs) = parse_attributes(args.colfmt, len(line))
                except Exception as e:
                    print("ERROR: attribute parsing failed: ", e, file=sys.stderr)
                    sys.exit(2)
                if not args.noheader:
                    warn_if_ragged(line_count, len(line), len(header_attrs))
                    writer.writeheadrow(line, header_attrs, column_names)
                    continue
            warn_if_ragged(line_count, len(line), len(data_attrs))
            writer.writerow(line, data_attrs)
    except Exception as e:
        # reader.line_num is the physical input line, which is what the user sees;
        # line_count (the number of records handled so far) is the fallback.
        error_line = getattr(reader, 'line_num', None) or line_count
        print("ERROR: ", e, " at line %d" % error_line, file=sys.stderr)
        exit_code = 3
    finally:
        # Close whatever is still open so that the output stays parseable HTML
        # even when we bail out in the middle of the table.
        if writer.row_open:
            w("</tr>\n")
        if not args.notabletag:
            w("</table>\n")
    if exit_code != 0:
        sys.exit(exit_code)


if __name__ == '__main__':
    main()
