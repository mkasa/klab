#!/usr/bin/env perl

#
# @author Masahiro Kasahara (masahiro@kasahara.ws)
#
use strict;
use warnings;

use Pod::Usage;
use Getopt::Long;
use Cwd;
use Term::ANSIColor;

my $flag_debug      = 0;
my $flag_help       = 0;
my $flag_man        = 0;
my $flag_noparallel = 0;

# Options before the subcommand belong to rep itself; anything after the
# subcommand is left in @ARGV so it can be passed through to the underlying VCS.
Getopt::Long::Configure("require_order");
GetOptions("debug"      => \$flag_debug,
           "help"       => \$flag_help,
           "man"        => \$flag_man,
           "noparallel" => \$flag_noparallel
    ) or pod2usage(-exitval => 2, -verbose => 0, -input => \*DATA);

my $command = shift;

if($flag_help || (defined $command && $command =~ /^help$/i)) {
    my $is_in_synopsis = 0;
    while(<DATA>) {
        if($is_in_synopsis) {
            if(m|^=|) {
                $is_in_synopsis = 0;
            } else {
                print STDERR;
            }
        } else {
            if(m|SYNOPSIS|) {
                $is_in_synopsis = 1;
            }
        }
    }
    exit 0; # an explicit help request is not an error
}
pod2usage(-verbose => 2, -exitval => 0, -input => \*DATA) if($flag_man || (defined $command && $command =~ /^man$/i));

unless(defined $command) {
    print STDERR "Usage: rep [options] <command> [vcs-options]\n";
    print STDERR "rep -help, or rep -man to get more information.\n";
    exit 0;
}

if($command eq 'which')   { cmd_which(); exit 0; }
if($command eq 'list')    { cmd_list(); exit 0; }
if($command eq 'pull')    { cmd_pull(@ARGV); exit 0; }
if($command eq 'pullall') { cmd_pullall(@ARGV); exit 0; }
if($command eq 'pullall_child') { my $dir = shift; cmd_pullall_child($dir, @ARGV); exit 0; }
if($command eq 'fetch')   { cmd_fetch(); exit 0; }
if($command eq 'fetchall') { cmd_fetchall(); exit 0; }
if($command eq 'fetchall_child') { my $dir = shift; cmd_fetchall_child($dir); exit 0; }
if($command eq 'stat' || $command eq 'status') {
    cmd_status(); exit 0;
}
if($command eq 'statall' || $command eq 'statusall') {
    cmd_statusall(); exit 0;
}
if($command eq 'outgoing') { cmd_outgoing(); exit 0; }
if($command eq 'outgoingall' || $command eq 'ogall') {
    cmd_outgoingall(); exit 0;
}
if($command eq 'outgoingall_child') {
    my $dir = shift;
    cmd_outgoingall_child($dir); exit 0;
}
if($command eq 'origin') { cmd_origin(); exit 0; }
if($command eq 'originall' || $command eq 'orall') {
    cmd_originall(); exit 0;
}
if($command eq 'ignore') { my $sub_arg = shift; cmd_ignore($sub_arg); exit 0; }

print "Unknown command '$command'\n";
exit 1;

sub cl($)
{
    my $s = shift;
    my $term = defined $ENV{'TERM'} ? $ENV{'TERM'} : '';
    if(-t STDOUT && $term ne 'dumb') {
        return color($s);
    } else {
        return "";
    }
}

# Quote a single string so that a POSIX shell passes it through verbatim.
sub sq($)
{
    my $s = shift;
    $s = '' unless(defined $s);
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

# Run a command given as an argv list (no shell is involved) and return its
# output as a list of chomped lines. $? is set as usual. LC_ALL/LANG are forced
# to C so that we never have to parse localized prose.
sub capture
{
    my @cmd = @_;
    local $ENV{'LC_ALL'} = 'C';
    local $ENV{'LANG'}   = 'C';
    my $ph;
    unless(open($ph, "-|", @cmd)) {
        $? = -1;
        return ();
    }
    my @out = <$ph>;
    close $ph;
    chomp @out;
    return @out;
}

sub dosh($)
{
	my $shellcmd = shift;
	print "\$ $shellcmd\n";
	system $shellcmd;
    if($? == -1) {
        print cl('red') . "ERROR: an error occurred while executing the above command line." . cl('reset') . "\n";
    } elsif($?) {
		my $code = $? >> 8;
		print cl('red') . "ERROR: retcode = $code" . cl('reset') . "\n";
        return $code;
	}
	return 0;
}

# Quote a list of strings for a POSIX shell and join them with spaces.
sub shell_quote
{
    return join(' ', map { sq($_) } @_);
}

# Tells the repository type of $dir itself (the ancestors of $dir are NOT
# looked at; see get_repo_type_ancestor() for that).
sub get_repo_type($)
{
    my $dir = shift;
    $dir = '.' unless(defined $dir && $dir ne '');
    $dir =~ s|/+$|| while($dir =~ m|.+/$|); # keep a bare '/' as is
    return "git" if(-e $dir . "/.git");
    return "cvs" if(-e $dir . "/CVSROOT");
    return "svn" if(-e $dir . "/.svn");
    return "rcs" if(-e $dir . "/RCS");
    return "hg"  if(-e $dir . "/.hg");
    return undef;
}

# Same as get_repo_type(), but walks up towards the root so that it also works
# when we stand in a *subdirectory* of a working copy. The path is made
# absolute first: otherwise stripping the last component of a relative name
# such as '.' or 'foo' fails immediately and the walk never takes a step.
sub get_repo_type_ancestor($)
{
    my $dir = shift;
    $dir = '.' unless(defined $dir && $dir ne '');
    my $abs = Cwd::abs_path($dir);
    return get_repo_type($dir) unless(defined $abs);
    while(1) {
        my $type = get_repo_type($abs);
        return $type if(defined $type);
        last if($abs eq '/' || $abs !~ m|/|);
        $abs =~ s|/[^/]*$||;
        $abs = '/' if($abs eq '');
    }
    return undef;
}

sub cmd_which
{
    my $type = get_repo_type_ancestor(".");
    unless(defined $type) {
        print "unknown\t.\n";
    } else {
        print cl('green') . $type . cl('reset') . "\t.\n";
    }
}

sub cmd_list
{
    my @dirnames = <*>;
    for my $dirname (@dirnames) {
        my $type = get_repo_type($dirname);
        unless(defined $type) {
            print "unknown\t$dirname\n";
        } else {
            print cl('green') . $type . cl('reset') . "\t$dirname\n";
        }
    }
}

sub report_vcs_error($)
{
    my $what = shift;
    print STDERR cl('red') . "ERROR: '$what' failed in '" . Cwd::getcwd() . "'." . cl('reset') . "\n";
    return;
}

sub pull
{
    my ($type, @vcs_options) = @_;
    my $opts = @vcs_options ? " " . shell_quote(@vcs_options) : "";
    if($type eq 'git') {
        my @s = capture("git", "remote");
        if($?) { report_vcs_error("git remote"); return; }
        if(@s > 0) {
            dosh("git pull --rebase$opts");
        } else {
            print "It looks like a local repository.\n";
        }
    } elsif($type eq 'cvs') {
        dosh("cvs up$opts");
    } elsif($type eq 'svn') {
        dosh("svn up$opts");
    } elsif($type eq 'rcs') {
        print "Nothing to do\n";
    } elsif($type eq 'hg') {
        # 'hg paths' works from any subdirectory of the working copy, unlike
        # reading ./.hg/hgrc directly.
        my @s = capture("hg", "paths");
        if(!$? && grep { m|^default\s*=| } @s) {
            my $rs = return_status_silently($type);
            unless(defined $rs) {
                print "Could not determine the status, so nothing was pulled.\n";
            } elsif(0 < $rs) {
                print "You have modifiled files.\n";
            } else {
                dosh("hg pull -u$opts");
            }
        } else {
            print "It looks like a local repository.\n";
        }
    } else {
        print STDERR cl('red') . "ERROR: Internal error (pull)." . cl('reset') . "\n";
        exit 3;
    }
}

sub fetch($)
{
    my $type = shift;
    if($type eq 'git') {
        my @s = capture("git", "remote");
        if($?) { report_vcs_error("git remote"); return; }
        if(@s > 0) {
            dosh("git fetch");
        } else {
            print "It looks like a local repository.\n";
        }
    } elsif($type eq 'cvs' || $type eq 'svn' || $type eq 'rcs') {
        print "Nothing to do\n";
    } elsif($type eq 'hg') {
        # 'hg pull' without -u only adds changesets to the local repository,
        # so it is safe even when the working copy has modified files.
        my @s = capture("hg", "paths");
        if(!$? && grep { m|^default\s*=| } @s) {
            dosh("hg pull");
        } else {
            print "It looks like a local repository.\n";
        }
    } else {
        print STDERR cl('red') . "ERROR: Internal error (fetch)." . cl('reset') . "\n";
        exit 3;
    }
}

sub status($)
{
    my $type = shift;
    if($type eq 'git') {
        dosh("git status");
    } elsif($type eq 'cvs') {
        dosh("cvs status");
    } elsif($type eq 'svn') {
        dosh("svn status");
    } elsif($type eq 'rcs') {
        print "Not implemented.\n";
    } elsif($type eq 'hg') {
        dosh("hg status");
    } else {
        print STDERR "ERROR: Internal error (status).\n";
        exit 3;
    }
}

# Returns 0 when the working copy is clean, 1 when it has local modifications,
# and undef when we cannot tell (unsupported VCS, or the VCS command failed).
# It never dies, so that a sweep over many repositories is not aborted by a
# single broken one.
sub return_status_silently($)
{
    my $type = shift;
    if($type eq 'git') {
        # --porcelain is a stable, machine readable format; the old test
        # matched the English prose of 'git status', which changed wording
        # between git versions and is translated in non-English locales.
        my @s = capture("git", "status", "--porcelain");
        if($?) { report_vcs_error("git status --porcelain"); return undef; }
        return (0 < @s) ? 1 : 0;
    } elsif($type eq 'svn') {
        my @s = capture("svn", "status");
        if($?) { report_vcs_error("svn status"); return undef; }
        return (0 < @s) ? 1 : 0;
    } elsif($type eq 'hg') {
        my @s = capture("hg", "status");
        if($?) { report_vcs_error("hg status"); return undef; }
        return (0 < @s) ? 1 : 0;
    } elsif($type eq 'cvs' || $type eq 'rcs') {
        return undef; # not supported
    } else {
        print STDERR "ERROR: Internal error (status).\n";
        exit 3;
    }
}

sub get_repo_type_of_current_dir()
{
    my $type = get_repo_type_ancestor(".");
    unless(defined $type) {
        print STDERR cl('red') . "ERROR: Repository type is not known.\n";
        print STDERR             "       Maybe just the current directory is not a repository?" . cl('reset') . "\n";
        exit 1;
    }
    return $type;
}

sub is_gnu_parallel_available()
{
    # We invoke 'sem' (and 'sem --wait') below, so that is what has to exist.
    # Probing for 'parallel' is wrong: Debian/Ubuntu's moreutils ships a
    # 'parallel' that comes without 'sem' at all.
    my ($sem_path) = capture("which", "sem");
    return undef if($?);
    return undef unless(defined $sem_path && $sem_path ne '');
    return $sem_path if(-x $sem_path);
    return undef;
}

# Each argument must be a complete, already shell-quoted command line: 'sem'
# joins whatever it is given with blanks and hands the result to a shell.
sub gnu_parallel
{
    my $ok = 1;
    for my $shellcmd (@_) {
        print STDERR "\% sem -j+2 $shellcmd\n" if(0 < $flag_debug);
        my $r = system("sem", "-j+2", $shellcmd);
        if($r != 0) {
            print STDERR cl('red') . "ERROR: could not run 'sem' (rc=$r). Is GNU parallel installed?" . cl('reset') . "\n";
            $ok = 0;
        }
    }
    my $r = system("sem", "--wait");
    if($r != 0) {
        print STDERR cl('red') . "ERROR: 'sem --wait' failed (rc=$r)." . cl('reset') . "\n";
        $ok = 0;
    }
    return $ok;
}

sub cmd_pull
{
    my @vcs_options = @_;
    my $type = get_repo_type_of_current_dir();
    pull($type, @vcs_options);
}

sub cmd_fetch
{
    my $type = get_repo_type_of_current_dir();
    fetch($type);
}

sub cmd_status
{
    my $type = get_repo_type_of_current_dir();
    status($type);
}

sub cmd_pullall_sub
{
    my $dirname = shift;
    my $base_dir = shift;
    my @vcs_options = @_;
    my $type = get_repo_type($dirname);
    if(defined $type) {
        if(chdir $dirname) {
            print cl('green') . "$type" . cl('reset') . "\t$dirname\t";
            pull($type, @vcs_options);
            unless(chdir $base_dir) {
                print cl('red') . "ERROR: Could not come back to '$base_dir'\n";
                print "       You removed the directory, or changed the permission during execution?" . cl('reset') . "\n";
                exit 3;
            }
        } else {
            print cl('red') . "denied" . cl('reset') . "\t$dirname\n";
        }
    } else {
        print "unknown\t$dirname\n";
    }
}

sub cmd_pullall_child
{
    my $dirname = shift;
    unless(defined $dirname) {
        print STDERR "ERROR: pullall_child requires a directory name.\n";
        exit 1;
    }
    my @vcs_options = @_;
    my $base_dir = Cwd::getcwd();
    cmd_pullall_sub($dirname, $base_dir, @vcs_options);
}

sub cmd_pullall
{
    my @vcs_options = @_;
    my @dirnames = <*>;
    my $base_dir = Cwd::getcwd();
    my $is_gnu_parallel_available = is_gnu_parallel_available();
    unless($is_gnu_parallel_available && !$flag_noparallel) {
        for my $dirname (@dirnames) {
            cmd_pullall_sub($dirname, $base_dir, @vcs_options);
        }
    } else {
        my @parallel_commands;
        for my $dirname (@dirnames) {
            my $type = get_repo_type($dirname);
            if(defined $type) {
                push(@parallel_commands, sq($0) . " pullall_child " . shell_quote($dirname, @vcs_options));
            } else {
                print "unknown\t$dirname\n";
            }
        }
        gnu_parallel(@parallel_commands);
    }
}

sub cmd_fetchall_sub($$)
{
    my $dirname = shift;
    my $base_dir = shift;
    my $type = get_repo_type($dirname);
    if(defined $type) {
        if(chdir $dirname) {
            print cl('green') . "$type" . cl('reset') . "\t$dirname\t";
            fetch($type);
            unless(chdir $base_dir) {
                print cl('red') . "ERROR: Could not come back to '$base_dir'\n";
                print "       You removed the directory, or changed the permission during execution?" . cl('reset') . "\n";
                exit 3;
            }
        } else {
            print cl('red') . "denied" . cl('reset') . "\t$dirname\n";
        }
    } else {
        print "unknown\t$dirname\n";
    }
}

sub cmd_fetchall_child
{
    my $dirname = shift;
    unless(defined $dirname) {
        print STDERR "ERROR: fetchall_child requires a directory name.\n";
        exit 1;
    }
    my $base_dir = Cwd::getcwd();
    cmd_fetchall_sub($dirname, $base_dir);
}

sub cmd_fetchall
{
    my @dirnames = <*>;
    my $base_dir = Cwd::getcwd();
    my $is_gnu_parallel_available = is_gnu_parallel_available();
    unless($is_gnu_parallel_available && !$flag_noparallel) {
        for my $dirname (@dirnames) {
            cmd_fetchall_sub($dirname, $base_dir);
        }
    } else {
        my @parallel_commands;
        for my $dirname (@dirnames) {
            my $type = get_repo_type($dirname);
            if(defined $type) {
                push(@parallel_commands, sq($0) . " fetchall_child " . sq($dirname));
            } else {
                print "unknown\t$dirname\n";
            }
        }
        gnu_parallel(@parallel_commands);
    }
}

sub cmd_statusall_sub($)
{
    my $dirname = shift;
    my $type = get_repo_type($dirname);
    if(defined $type) {
        if(chdir $dirname) {
            my $ret_status = return_status_silently($type);
            unless(defined $ret_status) {
                print cl('yellow') . "?" . cl('reset') . "\t$type\t$dirname\n";
            } elsif($ret_status == 0) {
                print " \t$type\t$dirname\n";
            } else {
                print cl('green') . "M" . cl('reset') . "\t$type\t$dirname\n";
            }
        } else {
            print cl('red') . "X" . cl('reset') . "\tdenied\t$dirname\n";
        }
    } else {
        print cl('red') . "-" . cl('reset') . "\tunknown\t$dirname\n";
    }
}

sub cmd_statusall
{
    my @dirnames = <*>;
    my $base_dir = Cwd::getcwd();
    for my $dirname (@dirnames) {
        cmd_statusall_sub($dirname);
        unless(chdir $base_dir) {
            print cl('red') . "ERROR: Could not come back to '$base_dir'\n";
            print "       You removed the directory, or changed the permission during execution?" . cl('reset') . "\n";
            exit 3;
        }
    }
}

sub git_get_current_branch
{
    # 'git branch' output has to be parsed and, in a detached HEAD or during a
    # rebase, yields things like '(HEAD detached at 1a2b3c4)'.
    # symbolic-ref gives the plain branch name, or fails quietly if there is
    # none, which is exactly what we want.
    my ($branch) = capture("git", "symbolic-ref", "--quiet", "--short", "HEAD");
    return undef if($?);
    return undef unless(defined $branch && $branch ne '');
    return $branch;
}

# Returns the one-character mark that describes the outgoing state of the
# repository in the current directory.
sub outgoing_mark($)
{
    my $type = shift;
    my $ret_status = return_status_silently($type);
    unless(defined $ret_status) {
        return cl('red') . "U" . cl('reset');   # unsupported / could not tell
    }
    if($ret_status != 0) {
        return cl('green') . "M" . cl('reset'); # locally modified
    }
    if($type eq 'hg') {
        capture("hg", "outgoing");
        return (($? >> 8) == 0) ? cl('green') . "O" . cl('reset') : " ";
    } elsif($type eq 'git') {
        capture("git", "fetch");
        my $current_branch = git_get_current_branch();
        return cl('red') . "X" . cl('reset') unless(defined $current_branch);
        my ($remoterep) = capture("git", "config", "branch.$current_branch.remote");
        $remoterep = '' unless(defined $remoterep);
        return cl('red') . "X" . cl('reset') if($remoterep eq '');
        my ($remotebra) = capture("git", "config", "branch.$current_branch.merge");
        $remotebra = '' unless(defined $remotebra);
        $remotebra =~ s|^[^/]*/[^/]*/||;
        return cl('red') . "X" . cl('reset') if($remotebra eq '');
        my @result = capture("git", "log", "$remoterep/$remotebra..");
        # 'git log <range>' prints nothing at all when the range is empty.
        return (0 < @result) ? cl('green') . "O" . cl('reset') : " ";
    } elsif($type eq 'svn') {
        my @s = capture("svn", "status", "-u");
        return cl('red') . "X" . cl('reset') if($?);
        return (1 < scalar(@s)) ? cl('green') . "O" . cl('reset') : " ";
    }
    return cl('red') . "U" . cl('reset');
}

sub cmd_outgoing
{
    my $type = get_repo_type_of_current_dir();
    print outgoing_mark($type) . "\t$type\t.\n";
}

sub cmd_outgoingall_sub
{
    my ($dirname, $base_dir) = @_;
    my $type = get_repo_type($dirname);
    if(defined $type) {
        if(chdir $dirname) {
            print outgoing_mark($type);
            print "\t$type\t$dirname\n";
            unless(chdir $base_dir) {
                print cl('red') . "ERROR: Could not come back to '$base_dir'\n";
                print "       You removed the directory, or changed the permission during execution?" . cl('reset') . "\n";
                exit 3;
            }
        } else {
            print cl('red') . "X" . cl('reset') . "\tdenied\t$dirname\n";
        }
    } else {
        print cl('red') . "-" . cl('reset') . "\tunknown\t$dirname\n";
    }
}

sub cmd_outgoingall_child
{
    my $dirname = shift;
    unless(defined $dirname) {
        print STDERR "ERROR: outgoingall_child requires a directory name.\n";
        exit 1;
    }
    my $base_dir = Cwd::getcwd();
    cmd_outgoingall_sub($dirname, $base_dir);
}

sub cmd_outgoingall
{
    my @dirnames = <*>;
    my $base_dir = Cwd::getcwd();
    my $is_gnu_parallel_available = is_gnu_parallel_available();
    unless($is_gnu_parallel_available && !$flag_noparallel) {
        for my $dirname (@dirnames) {
            cmd_outgoingall_sub($dirname, $base_dir);
        }
    } else {
        my @parallel_commands;
        for my $dirname (@dirnames) {
            my $type = get_repo_type($dirname);
            if(defined $type) {
                push(@parallel_commands, sq($0) . " outgoingall_child " . sq($dirname));
            } else {
                print "unknown\t$dirname\n";
            }
        }
        gnu_parallel(@parallel_commands);
    }
}

sub show_origin
{
    my $type = shift;
    $type = get_repo_type(".") unless(defined $type);
    unless(defined $type) {
        print "not supported\n";
        return;
    }
    if($type eq 'git') {
        my @s = grep { m|\(fetch\)| } capture("git", "remote", "-v");
        if(@s == 0) {
            print "local\n";
        } else {
            my $t = $s[0];
            $t =~ s|^\S+\s+||;
            $t =~ s|\s+\(fetch\)$||;
            print "$t\n";
        }
    } elsif($type eq 'hg') {
        for(capture("hg", "paths")) {
            if(/^\s*default\s*=\s*(\S.*)$/) {
                print "$1\n"; return;
            }
        }
        print "local\n";
    } else {
        print "not supported\n";
    }
}

sub cmd_origin
{
    my $type = get_repo_type_of_current_dir();
    print ".\t" . cl('green') . $type . cl('reset') . "\t";
    show_origin($type);
}

sub cmd_originall
{
    my @dirnames = <*>;
    my $base_dir = Cwd::getcwd();
    my $longest_dirname_len = 0;
    for my $dirname (@dirnames) {
        $longest_dirname_len = length($dirname) if(length($dirname) > $longest_dirname_len);
    }
    for my $dirname (@dirnames) {
        my $type = get_repo_type($dirname);
        print "$dirname" . (" "x($longest_dirname_len - length($dirname) + 1));
        if(defined $type) {
            if(chdir $dirname) {
                print cl('green') . "$type" . cl('reset') . "\t";
                show_origin($type);
                unless(chdir $base_dir) {
                    print cl('red') . "ERROR: Could not come back to '$base_dir'\n";
                    print "       You removed the directory, or changed the permission during execution?" . cl('reset') . "\n";
                    exit 3;
                }
            } else {
                print "$dirname\terror (chdir1)\n";
            }
        } else {
            print "unknown\n";
        }
    }
}

sub cmd_ignore
{
    my $subarg = shift;
    $subarg = '' unless(defined $subarg);
    my $type = get_repo_type_of_current_dir();
    if($type eq 'git') {
        if($subarg eq 'c') {
            if(-e '.gitignore') {
                print STDERR "It seems you already have .gitignore. Aborts for safety.\n";
            } else {
                open my $fh, ">", ".gitignore" or die "Could not create .gitignore: $!";
                print $fh <<'EOF';
# Ignore backup files
*~
# Ignore dot files
.*
# ... but not .gitignore itself, so that 'git add .gitignore' works.
!.gitignore
EOF
                close $fh;
            }
        } else {
            print <<'EOF';
# place this as $REPOSITORY/.gitignore
# lines starting with '#' are comments.
#
# Ignore backup files
*~

# Ignore dot files
.*
#
# Do not ignore .gitignore itself although .* is ignored because of the above
# line. Without this, 'git add .gitignore' refuses to add the file.
!.gitignore
#
# Do not ignore .htaccess although .* is ignored because of the above line.
!.htaccess
#
# Ignore 'configure' on the top directory, but retain 'configure' in non-top directory.
#/configure
# Please do 'rep ignore c' to create a template .gitignore file.
# Do not forget to do 'git add .gitignore' when you store it in the repository.
EOF
        }
    } elsif($type eq 'hg') {
        if($subarg eq 'cg') {
            if(-e '.hgignore') {
                print STDERR "It seems you already have .hgignore. Aborts for safety.\n";
            } else {
                open my $fh, ">", ".hgignore" or die "Could not create .hgignore: $!";
                print $fh <<'EOF';
syntax: glob
#
*~
EOF
                close $fh;
            }
        } elsif($subarg eq 'cr') {
            if(-e '.hgignore') {
                print STDERR "It seems you already have .hgignore. Aborts for safety.\n";
            } else {
                open my $fh, ">", ".hgignore" or die "Could not create .hgignore: $!";
                print $fh <<'EOF';
syntax: regexp
#
^.*~$
EOF
                close $fh;
            }
        } else {
            print <<'EOF';
# place this as $REPOSITORY/.hgignore
# you can either select glob or regexp styles
#
# here is glob style
syntax: glob
foo
hoge/fuga
*~
#
# here is regexp style
syntax: regexp
^foo$
^hoge/fuga$
^.*~$
# Please do 'rep ignore cg' to create a glob-style template of .hgignore.
# Please do 'rep ignore cr' to create a regexp-style template of .hgignore.
# Do not forget to do 'hg add .hgignore' when you store it in the repository.
EOF
        }
    } else {
        print STDERR "Sorry, 'rep ignore' does not support '$type' repositories.\n";
    }
}

__DATA__
=pod

=head1 NAME

rep - code repository manager for SVN/Mercurial/git

=head1 SYNOPSIS

rep [options] <command> [vcs-options]

Options given before <command> are interpreted by rep itself.
For `pull' and `pullall', options given after the command are passed
through verbatim to the underlying version control system
(e.g., `rep pull --rebase' runs `git pull --rebase' in a git repository).

Options:
   -help                brief help message
   -man                 see the manual

Commands:
   help                 brief help message
   man                  see the manual
   which                print the type of version control system for the current directory
   list                 list the repositories directly under the current directory
   pull [vcs-options]   pull from the remote origin (for DVCS only); extra options are passed to the underlying VCS
   pullall [vcs-options] do `pull' for the repositories directly under the current directory
   fetch                fetch from the remote origin without updating the working copy (for DVCS only)
   fetchall             do `fetch' for the repositories directly under the current directory
   stat/status          check the change status
   statall              do `stat' for the repositories directly under the current directory
   outgoing             check if the outgoing changes exist (for DVCS only)
   ogall/outgoingall    do `outgoing' for the repositories directory under the current directory
   origin               show the origin (when you cloned a repository from a remote path, that path is the origin.)
   orall/originall      do `origin' for the repositories directory under the current directory
   ignore               create a file to ignore some types of files

=over 8

=item B<-help>

Print a brief help message and exits.

=back

=head1 DESCRIPTION

When you have the checkout directories of different versioning system such as CVS/SVN/Mercurial/git,
you might often get confused with their slight differences in command-line syntax,
or you might want to do similar commands to checkout directories of different versioning system.
B<rep> to help you do the jobs in such a situation.


=cut


