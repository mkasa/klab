#!/bin/bash

# tmux requires unrecognized OSC sequences to be wrapped with DCS tmux;
# <sequence> ST, and for all ESCs in <sequence> to be replaced with ESC ESC. It
# only accepts ESC backslash for ST. We use TERM instead of TMUX because TERM
# gets passed through ssh.
function print_osc() {
    if [[ $TERM == screen* ]]; then
        printf "\033Ptmux;\033\033]"
    else
        printf "\033]"
    fi
}

# More of the tmux workaround described above.
function print_st() {
    if [[ $TERM == screen* ]]; then
        printf "\a\033\\"
    else
        printf "\a"
    fi
}

function load_version() {
    if [ -z ${IMGCAT_BASE64_VERSION+x} ]; then
        IMGCAT_BASE64_VERSION=$(base64 --version 2>&1)
        export IMGCAT_BASE64_VERSION
    fi
}

function b64_encode() {
    load_version
    if [[ $IMGCAT_BASE64_VERSION =~ GNU ]]; then
        # Disable line wrap
        base64 -w0
    else
        base64
    fi
}

function b64_decode() {
    load_version
    if [[ $IMGCAT_BASE64_VERSION =~ fourmilab ]]; then
        BASE64ARG=-d
    elif [[ $IMGCAT_BASE64_VERSION =~ GNU ]]; then
        BASE64ARG=-di
    else
        BASE64ARG=-D
    fi
    base64 $BASE64ARG
}

# print_image filename inline base64contents print_filename
#   filename: Filename to convey to client
#   inline: 0 or 1
#   base64contents: Base64-encoded contents
#   print_filename: If non-empty, print the filename
#                   before outputting the image
#   width: Width in terms of the terminal width. See https://iterm2.com/3.2/documentation-images.html for how to specify width.
#   height: Height in terms of the terminal height. See https://iterm2.com/3.2/documentation-images.html for how to specify height.
function print_image() {
    print_osc
    printf '1337;File='
    if [[ -n $1 ]]; then
        printf "name=%s;" "$(printf "%s" "$1" | b64_encode)"
    fi

    printf "%s" "$3" | b64_decode | wc -c | awk '{printf "size=%d",$1}'
    printf ";inline=%s" "$2"
    if [[ -n $5 ]]; then
	    echo -n ";width="; echo -n "$5"
    fi
    if [[ -n $6 ]]; then
	    echo -n ";height="; echo -n "$6"
    fi
    printf ":"
    printf "%s" "$3"
    print_st
    printf '\n'
    if [[ -n $4 ]]; then
        echo "$1"
    fi
}

function error() {
    echo "ERROR: $*" 1>&2
}

function show_help() {
    echo "Usage: imgcat2 [-p] [-W width] [-H height] [-u url] filename ..." 1>&2
    echo "   or: cat filename | imgcat2" 1>&2
    echo "   or: imgcat2 -u url" 1>&2
    echo "" 1>&2
    echo "Options:" 1>&2
    echo "  -p, --print          print the filename before the image" 1>&2
    echo "  -W, --width  VALUE   image width  (e.g. 100px, 50%, 10; default 35%)" 1>&2
    echo "  -H, --height VALUE   image height (e.g. 100px, 50%, 10)" 1>&2
    echo "  -u, --url    URL     download an image from URL and show it" 1>&2
    echo "  -h, --help           show this help" 1>&2
    echo "" 1>&2
    echo "VALUE for -W/-H follows the iTerm2 spec:" 1>&2
    echo "  N    number of character cells" 1>&2
    echo "  Npx  number of pixels" 1>&2
    echo "  N%   percentage of the terminal width/height" 1>&2
    echo "" 1>&2
    echo "Options may be given anywhere on the command line; they all apply" 1>&2
    echo "to every image. Use -- to end option parsing." 1>&2
}

function check_dependency() {
    if ! (builtin command -V "$1" >/dev/null 2>&1); then
        echo "imgcat: missing dependency: can't find $1" 1>&2
        exit 1
    fi
}

# validate_size <option name> <value>
# The value must follow the iTerm2 spec: N, Npx, N% or "auto".
function validate_size() {
    case "$2" in
    auto) return 0 ;;
    esac
    if [[ ! $2 =~ ^[0-9]+(px|%)?$ ]]; then
        error "$1: invalid size '$2' (expected N, Npx, N% or auto)"
        exit 1
    fi
}

# require_value <option name> <number of remaining args>
function require_value() {
    if [ "$2" -lt 2 ]; then
        error "$1 requires a value"
        exit 1
    fi
}

# fetch_url <url>
# Writes the base64-encoded body to stdout and returns non-zero on any
# failure (including HTTP errors, thanks to curl -f).
function fetch_url() {
    (
        set -o pipefail
        curl -fsS -- "$1" | b64_encode
    )
}

## Main

if [ -t 0 ]; then
    has_stdin=f
else
    has_stdin=t
fi

# Show help if no arguments and no stdin.
if [ $has_stdin = f ] && [ $# -eq 0 ]; then
    show_help
    exit
fi

check_dependency awk
check_dependency base64
check_dependency wc

print_width="35%"
print_height=""
print_filename=""

# Pass 1: parse ALL options first, and collect the targets (files and URLs) so
# that an option given after a file name still applies to that file.
targets=()
while [ $# -gt 0 ]; do
    case "$1" in
    -h | --help)
        show_help
        exit
        ;;
    -W | --width)
        require_value "$1" "$#"
        validate_size "$1" "$2"
        print_width=$2
        shift
        ;;
    -H | --height)
        require_value "$1" "$#"
        validate_size "$1" "$2"
        print_height=$2
        shift
        ;;
    -p | --p | --print)
        print_filename=1
        ;;
    -u | --u | --url)
        require_value "$1" "$#"
        check_dependency curl
        targets+=("url:$2")
        shift
        ;;
    --)
        shift
        while [ $# -gt 0 ]; do
            targets+=("file:$1")
            shift
        done
        break
        ;;
    -*)
        error "Unknown option flag: $1"
        show_help
        exit 1
        ;;
    *)
        targets+=("file:$1")
        ;;
    esac
    shift
done

# Pass 2: render the targets, in the order they were given.
if [ ${#targets[@]} -gt 0 ]; then
    has_stdin=f
    for target in "${targets[@]}"; do
        kind=${target%%:*}
        value=${target#*:}
        if [ "$kind" = url ]; then
            if ! encoded_image=$(fetch_url "$value"); then
                error "Could not download '$value'"
                exit 2
            fi
            print_image "$value" 1 "$encoded_image" "$print_filename" "$print_width" "$print_height"
        else
            if [ -r "$value" ] && [ ! -d "$value" ]; then
                print_image "$value" 1 "$(b64_encode <"$value")" "$print_filename" "$print_width" "$print_height"
            else
                error "imgcat: $value: No such file or directory"
                exit 2
            fi
        fi
    done
fi

# Read and print stdin
if [ $has_stdin = t ]; then
    print_image "" 1 "$(cat | b64_encode)" "" "$print_width" "$print_height"
fi

exit 0
